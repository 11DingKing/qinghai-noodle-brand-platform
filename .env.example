# Service configuration (all values are examples)
QINGHAI_NOODLE_SERVER_PORT=49660
QINGHAI_NOODLE_SERVER_READ_TIMEOUT=30s
QINGHAI_NOODLE_SERVER_WRITE_TIMEOUT=30s
QINGHAI_NOODLE_SERVER_SHUTDOWN_TIMEOUT=15s
QINGHAI_NOODLE_STORAGE_DATA_DIR=./data
QINGHAI_NOODLE_STORAGE_SHARD_MAX_SIZE=1048576
QINGHAI_NOODLE_STORAGE_SYNC_ON_WRITE=true
QINGHAI_NOODLE_SCHEDULER_ESCALATION_INTERVAL=30s
QINGHAI_NOODLE_SCHEDULER_RECONCILIATION_INTERVAL=5m
QINGHAI_NOODLE_SCHEDULER_REEVAL_INTERVAL=1m
QINGHAI_NOODLE_SCHEDULER_MAX_RETRIES=3
QINGHAI_NOODLE_SCHEDULER_BASE_BACKOFF=1s
QINGHAI_NOODLE_SCHEDULER_TASK_TIMEOUT=10s
QINGHAI_NOODLE_LOGGING_LEVEL=info
QINGHAI_NOODLE_LOGGING_FORMAT=json
QINGHAI_NOODLE_BUSINESS_DEFAULT_DEADLINE=72h
QINGHAI_NOODLE_BUSINESS_ESCALATION_DEADLINE_EXTENSION=48h
QINGHAI_NOODLE_BUSINESS_MAX_ESCALATION_LEVEL=3
